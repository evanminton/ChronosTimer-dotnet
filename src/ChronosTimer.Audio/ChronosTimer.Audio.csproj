<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ChronosTimer.Audio</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>Dependency-free audio device backends for Chronos Timer: WinMM (Windows), AudioQueue (macOS, Mac Catalyst, iOS) and ALSA (Linux).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChronosTimer.Core\ChronosTimer.Core.csproj" />
  </ItemGroup>

</Project>
