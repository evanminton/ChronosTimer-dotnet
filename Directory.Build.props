<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Authors>Evan Minton</Authors>
    <Product>Chronos Timer</Product>
    <Version>1.0.0</Version>

    <!--
      Location of the LinearTimecode library. By default the LTC-dotnet repository is expected next to this one
      (flexorine/LTC-dotnet). Override with: dotnet build -p:LtcRepo=C:\path\to\LTC-dotnet
    -->
    <LtcRepo Condition="'$(LtcRepo)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../LTC-dotnet'))</LtcRepo>
    <LtcProject>$(LtcRepo)/src/LinearTimecode/LinearTimecode.csproj</LtcProject>
  </PropertyGroup>
</Project>
